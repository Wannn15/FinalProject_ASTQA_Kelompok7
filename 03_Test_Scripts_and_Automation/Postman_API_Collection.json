        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Login response has required fields', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equal(true);",
                  "    pm.expect(jsonData.data.user_id).to.be.a('number');",
                  "    pm.expect(jsonData.data.username).to.equal('admin');",
                  "    pm.expect(jsonData.data.role).to.equal('Admin');",
                  "});",
                  "",
                  "// Save session token for subsequent requests",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('session_token', jsonData.session_token);",
                  "pm.environment.set('user_id', jsonData.data.user_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"username\\\": \\\"admin\\\",\\n  \\\"password\\\": \\\"admin123\\\"\\n}"
            },
